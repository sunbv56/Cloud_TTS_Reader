# Firebase Auth / Firestore (keep existing values in .env or Fly secrets)
FIREBASE_SERVICE_ACCOUNT=
# Tolerance for small local clock drift when validating Firebase ID tokens.
FIREBASE_CLOCK_SKEW_SECONDS=30

# Storage provider: use "firebase" for rollback or "b2" after migration.
STORAGE_BACKEND=b2
B2_BUCKET_NAME=cloud-tts-reader-files
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=replace-with-new-key-id
B2_APPLICATION_KEY=replace-with-new-application-key
# Bound network waits/retries so one degraded B2 request cannot hold a Fly request forever.
B2_CONNECT_TIMEOUT_SECONDS=10
B2_READ_TIMEOUT_SECONDS=60
B2_MAX_ATTEMPTS=3
# A response stream can fail after bytes have already arrived; retry the full
# object download with an atomic temporary file.
B2_DOWNLOAD_MAX_ATTEMPTS=3
B2_DOWNLOAD_RETRY_BACKOFF_SECONDS=0.5
# RAM-heavy imports are intentionally serialized in code on the 256 MB machine.
IMPORT_RETRY_AFTER_SECONDS=15
# Bound concurrent synchronous SDK calls moved to worker threads.
STORAGE_IO_CONCURRENCY=4
FIRESTORE_IO_CONCURRENCY=4
# Keep concurrent TTS memory bounded on the 256 MB Fly machine.
MAX_WS_WORKERS=3
MAX_WS_QUEUE=24
MAX_WS_PER_USER=1

# Optional HTTP proxy for Edge TTS when Microsoft blocks the server IP.
# Accepts a full URL (http://user:pass@ip:port) or the vendor format ip:port:user:pass.
EDGE_TTS_PROXY=
# Emergency only: use gTTS (different voice, no word highlight) when Edge keeps failing.
GTTS_FALLBACK=0

# The backend enforces this limit for browser-uploaded WebP illustrations.
MAX_IMAGE_BYTES=153600
